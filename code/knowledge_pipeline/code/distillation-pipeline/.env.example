# Pipeline behavior
DISTILL_TENANT_ID=default
DISTILL_LOG_LEVEL=INFO

# Chunking
DISTILL_CHUNK_TOKEN_SIZE=800
DISTILL_CHUNK_TOKEN_OVERLAP=100

# LLM
DISTILL_LLM_PROVIDER=fake          # fake | anthropic | omlx
DISTILL_LLM_MODEL=claude-sonnet-4-5
ANTHROPIC_API_KEY=

# OMLX (when DISTILL_LLM_PROVIDER=omlx)
# DISTILL_LLM_MODEL=Qwen3.6-35B-A3B-4bit  # or other OMLX-supported models
# DISTILL_OMLX_BASE_URL=http://localhost:8000/v1
OMLX_API_KEY=

# Embeddings
DISTILL_EMBEDDER_PROVIDER=fake     # fake | anthropic | omlx
DISTILL_EMBEDDER_MODEL=Qwen3.6-35B-A3B-4bit

# Graph
DISTILL_GRAPH_BACKEND=in_memory    # in_memory | neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Dead letter
DISTILL_DEAD_LETTER_DIR=./dead_letter
